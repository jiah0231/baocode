{
  "manifest_version": 3,
  "name": "BaoCode assistant rendering fixture",
  "version": "0.0.1",
  "description": "Synthetic offline test, not the BaoCode product extension.",
  "permissions": [
    "sidePanel"
  ],
  "action": {
    "default_title": "BaoCode assistant fixture"
  },
  "background": {
    "service_worker": "fixture-worker.js"
  },
  "side_panel": {
    "default_path": "index.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; connect-src 'self';"
  }
}
